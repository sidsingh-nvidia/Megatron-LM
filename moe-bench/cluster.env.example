# Cluster-specific settings for moe-bench. Copy to moe-bench/cluster.env (git-ignored), fill in,
# and source it before submitting:
#   source moe-bench/cluster.env
#   sbatch moe-bench/server/launch.sh

# slurm options, read by sbatch from the environment.
export SBATCH_ACCOUNT=<account>
export SBATCH_PARTITION=<partition>
export SBATCH_QOS=<qos>

# Container mounts (pyxis --container-mounts) and images.
export MOE_BENCH_MOUNTS=<host_path>:<container_path>
export MOE_BENCH_SERVE_IMAGE=<path/to/mcore-inference.sqsh>   # server/launch.sh
export MOE_BENCH_CONVERT_IMAGE=<path/to/nemo.sqsh>            # convert/ (Megatron Bridge)

# Hugging Face cache: tokenizers for Super v3, and HF checkpoints for conversion.
export HF_HOME=<path/to/hf_home>

# Megatron (mcore) checkpoints served by server/launch.sh.
export NANOV3P5_CHECKPOINT=<path/to/nano-3.5-mcore>
export NANOV3P5_TOKENIZER=<path/to/nano-3.5-hf-tokenizer>
export SUPERV3_PRETRAINED_CHECKPOINT=<path/to/superv3-pretrained-checkpoint>
export SUPERV3_CHECKPOINT=<path/to/superv3-mcore>

# Output of convert/convert_ultra_tp8ep8.sh; server/launch.sh MODEL=ultrav3 serves it unless
# ULTRAV3_CHECKPOINT points elsewhere.
export ULTRA_MCORE_OUT=<path/to/nemotron-3-ultra-mcore-output>
# export ULTRAV3_CHECKPOINT=<path/to/nemotron-3-ultra-mcore>
