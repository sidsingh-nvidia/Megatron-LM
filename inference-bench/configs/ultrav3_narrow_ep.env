# Ultra v3, narrow EP: 2 nodes, TP8 x EP8 (one DP group, 64 experts per GPU).
# Wide-EP study baseline (REPORT.md, 2026-10-16); concurrency 1-16 per GPU.
# ~140 GB of weights per GPU, hence the small KV/state and prefix-cache buffers (25/25 OOMs).
MODEL=ultrav3
NODES=2
TP=8
BUFFER_GB=20
MAMBA_PREFIX_GB=20
MAMBA_RATIO=0.4
COMBINE_PRECISION=bf16
QOS=short
TIME=2:00:00

# Client sweep: total concurrency (8 GPUs), GSM8K prompts, 8192 output tokens (ignore_eos).
BENCH="8 16 32 64 128"
BENCH_OSL=8192
BENCH_ITERS=1
BENCH_WARMUP=1
