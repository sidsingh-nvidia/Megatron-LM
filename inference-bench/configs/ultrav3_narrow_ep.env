# Ultra v3, narrow EP on 64 GPUs: non-expert TP8 x DP8, experts EP8 x DP8 (a copy of the experts
# per TP8 replica, 64 experts per GPU). Simulates NVL8 domains: EP stays within 8 GPUs.
# ~140 GB of weights per GPU, hence the small KV/state and prefix-cache buffers (25/25 OOMs).
MODEL=ultrav3
NODES=16
# TP x EP groups fit in one node (Super) or two (Ultra), so only pairs of nodes need to
# share an NVLink domain.
SEGMENT=2
TP=8
EP=8
BUFFER_GB=20
MAMBA_PREFIX_GB=20
MAMBA_RATIO=0.4
COMBINE_PRECISION=bf16
QOS=short
TIME=2:00:00

# Steady-state client: total concurrency levels (64 GPUs) of closed-loop math-blend load, natural
# EOS with no output cap; 60 s warmup + 300 s window per level.
BENCH="64 128 256 512 1024"
