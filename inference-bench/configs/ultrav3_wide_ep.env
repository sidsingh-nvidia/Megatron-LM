# Ultra v3, wide EP: 16 nodes, TP8 x EP64 (8 DP groups, 8 experts per GPU).
# Wide-EP study (REPORT.md, 2026-10-16); concurrency 1-16 per GPU.
# 8 experts per GPU leave room for a larger KV/state buffer than narrow EP.
MODEL=ultrav3
NODES=16
TP=8
BUFFER_GB=80
MAMBA_RATIO=0.4
DISPATCHER=nvls
COMBINE_PRECISION=bf16
GEMM_BACKEND=trtllm_bf16_routed
QOS=short
TIME=2:00:00

# Client sweep: total concurrency (64 GPUs), GSM8K prompts, 8192 output tokens (ignore_eos).
BENCH="64 128 256 512 1024"
BENCH_OSL=8192
BENCH_ITERS=1
BENCH_WARMUP=1
