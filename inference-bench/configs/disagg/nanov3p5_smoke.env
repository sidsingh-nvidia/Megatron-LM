# Nano v3.5 PD smoke test: 1 prefill node + 1 decode node, sanity client.
#   Prefill pool: 1 node (4 GPUs), TP4, EP4 x ETP1.
#   Decode pool:  1 node (4 GPUs), TP4, EP4 x ETP1.
MODEL=nanov3p5
PD=1
# Prefill pool
PREFILL_NODES=1
PREFILL_TP=4
PREFILL_EP=4
PREFILL_ETP=1
# Decode pool
NODES=1
TP=4
EP=4
ETP=1
QOS=short
TIME=0:45:00
CLIENT=sanity
BENCH="1"
