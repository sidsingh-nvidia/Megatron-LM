# Super v3, narrow EP, prefill/decode disaggregated (PD=1): 3 nodes, 12 GPUs.
#   Prefill pool: 1 node (4 GPUs), non-expert TP4, experts EP4 x ETP1.
#   Decode pool:  2 nodes (8 GPUs), non-expert TP8, experts EP8 x ETP1, as in agg/superv3_narrow_ep.env.
# The decode pool hosts the frontend; the KV / Mamba state moves prefill -> decode over NIXL.
MODEL=superv3
PD=1
# Prefill pool
PREFILL_NODES=1
PREFILL_TP=4
PREFILL_EP=4
PREFILL_ETP=1
# Decode pool
NODES=2
TP=8
EP=8
ETP=1
# MoE: the decode pool runs the TRT-LLM routed MoE with the per-step EP row bound (its decode
# steps take the tight decode graphs sized by the EP-wide max token count); the prefill pool always
# runs the vLLM grouped GEMM with its token-count hint pinned to the full buffer height.
GEMM_BACKEND=trtllm_bf16_routed
COMBINE_PRECISION=bf16
BUFFER_GB=50
MAMBA_RATIO=0.4
CUDA_GRAPH_MAX_TOKENS=2048
QOS=short
TIME=2:00:00
# Same steady-state client and concurrency levels as agg/superv3_narrow_ep.env (total requests in
# flight against the job).
BENCH="8 16 32 64 128 256"
