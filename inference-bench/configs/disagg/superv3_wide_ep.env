# Super v3, wide EP, prefill/decode disaggregated (PD=1): 17 nodes, 68 GPUs.
#   Prefill pool: 1 node (4 GPUs), non-expert TP4, experts EP4 x ETP1.
#   Decode pool:  16 nodes (64 GPUs), non-expert TP4 x DP16, experts EP64 x ETP1, as in
#                 agg/superv3_wide_ep.env.
# The decode pool hosts the frontend; the KV / Mamba state moves prefill -> decode over NIXL.
MODEL=superv3
PD=1
# Prefill pool
PREFILL_NODES=1
PREFILL_TP=4
PREFILL_EP=4
PREFILL_ETP=1
# Decode pool
NODES=16
TP=4
EP=64
ETP=1
# MoE: the decode pool runs the TRT-LLM routed MoE with the per-step EP row bound (its decode
# steps take the tight decode graphs sized by the EP-wide max token count); the prefill pool always
# runs the vLLM grouped GEMM with its token-count hint pinned to the full buffer height.
GEMM_BACKEND=trtllm_bf16_routed
COMBINE_PRECISION=bf16
BUFFER_GB=50
MAMBA_RATIO=0.4
# Decode pool graphs capped at 512 tokens, as in agg/superv3_wide_ep.env.
CUDA_GRAPH_MAX_TOKENS=512
QOS=short
TIME=2:00:00
# Same steady-state client and concurrency levels as agg/superv3_wide_ep.env.
BENCH="64 128 256 512 1024 2048"
