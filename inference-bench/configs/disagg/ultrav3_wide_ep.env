# Ultra v3, wide EP, prefill/decode disaggregated (PD=1): 18 nodes, 72 GPUs (a whole NVL72 rack).
#   Prefill pool: 2 nodes (8 GPUs), non-expert TP8, experts EP8 x ETP1, as in agg/ultrav3_narrow_ep.env.
#   Decode pool:  16 nodes (64 GPUs), non-expert TP8 x DP8, experts EP64 x ETP1, as in
#                 agg/ultrav3_wide_ep.env.
# The decode pool hosts the frontend; the KV / Mamba state moves prefill -> decode over NIXL.
MODEL=ultrav3
PD=1
# Prefill pool
PREFILL_NODES=2
PREFILL_TP=8
PREFILL_EP=8
PREFILL_ETP=1
# Decode pool
NODES=16
TP=8
EP=64
ETP=1
# MoE: the decode pool runs the TRT-LLM routed MoE with the per-step EP row bound (its decode
# steps take the tight decode graphs sized by the EP-wide max token count); the prefill pool always
# runs the vLLM grouped GEMM with its token-count hint pinned to the full buffer height.
GEMM_BACKEND=trtllm_bf16_routed
COMBINE_PRECISION=bf16
# Buffers per pool: the decode pool gets wide EP's 80 GB (agg/ultrav3_wide_ep.env); the prefill
# pool holds 64 experts per GPU and fits only narrow EP's 25 GB (agg/ultrav3_narrow_ep.env).
BUFFER_GB=80
PREFILL_BUFFER_GB=25
MAMBA_RATIO=0.4
# Decode pool graphs capped at 512 tokens, as in agg/ultrav3_wide_ep.env.
CUDA_GRAPH_MAX_TOKENS=512
# Math prompts are short and distinct, so prefix caching saves nothing; it is off for the math runs.
PREFIX_CACHING=0
QOS=short
TIME=2:00:00
# Same steady-state client and concurrency levels as agg/ultrav3_wide_ep.env (total requests in
# flight against the job, 64 decode GPUs).
BENCH="64 128 256 512 1024"
