# Disaggregated prefill / decode smoke test on upstream main: nano-3.5, a prefill shard on node 1
# and a decode shard on node 2, each TP2 x DP2 for attention / Mamba and EP4 for the experts, behind
# main's native coordinator. TP2 matches nano's 2 KV heads: main's KV handoff needs the KV heads to
# divide over TP (at TP4 it rejects both engines: "inconsistent KV transfer geometry").
# Runs main's launcher from an upstream-main worktree (this branch predates end-to-end disagg).
# Create the worktree first:
#   git fetch upstream main && git worktree add tmp/upstream-main upstream/main
MODEL=nanov3p5
NODES=2
TP=2
EP=4
MEGATRON_DIR=tmp/upstream-main
SERVER_ENTRY=examples/inference/launch_inference_server.py
INFERENCE_SHARDS="tp=2,dp=2,ep=4,expt_tp=1,role=prefill+tp=2,dp=2,ep=4,expt_tp=1,role=decode"
DISAGG_BACKEND=nccl
# Disaggregation needs prefix caching on both roles and no Mamba prefix-cache buffer.
PREFIX_CACHING=1
MAMBA_PREFIX_GB=0
# main has no TRT-LLM backend and no --inference-moe-combine-precision.
GEMM_BACKEND=vllm
DISPATCHER=nvls
COMBINE_PRECISION=none
TIME=1:00:00

# Short smoke sweep: GSM8K prompts, fixed 256-token outputs.
CLIENT=smoke
BENCH="1 8"
BENCH_OSL=256
BENCH_ITERS=1
BENCH_WARMUP=1
