# Ultra v3, prefill/decode disaggregated (PD=1) with the same layout in both pools: 16 nodes, 64 GPUs.
#   Prefill pool: 8 nodes (32 GPUs), non-expert TP8 x DP4, experts EP32 x ETP1 (16 experts per GPU).
#   Decode pool:  8 nodes (32 GPUs), non-expert TP8 x DP4, experts EP32 x ETP1 (16 experts per GPU).
# Unlike ultrav3_ep32.env (TP8 x EP8 prefill), no pool runs narrow EP: each rank loads ~1/32 of the
# checkpoint instead of ~1/8, and the prefill pool holds as few experts per GPU as the decode pool.
# The decode pool hosts the frontend; the KV / Mamba state moves prefill -> decode over NIXL.
MODEL=ultrav3
PD=1
# Prefill pool
PREFILL_NODES=8
PREFILL_TP=8
PREFILL_EP=32
PREFILL_ETP=1
# Decode pool
NODES=8
TP=8
EP=32
ETP=1
# MoE: the decode pool runs the TRT-LLM routed MoE with the per-step EP row bound; the prefill pool
# always runs the vLLM grouped GEMM with its token-count hint pinned to the full buffer height.
GEMM_BACKEND=trtllm_bf16_routed
COMBINE_PRECISION=bf16
# Buffers: both pools hold 16 experts per GPU, so both get the 80 GB the EP32 decode pool of
# ultrav3_ep32.env runs with.
BUFFER_GB=80
PREFILL_BUFFER_GB=80
MAMBA_RATIO=0.4
CUDA_GRAPH_MAX_TOKENS=512
# Math prompts are short and distinct, so prefix caching saves nothing; it is off for the math runs.
PREFIX_CACHING=0
QOS=short
TIME=2:00:00
# 1 to 16 requests per decode GPU (total requests in flight against the job, 32 decode GPUs).
BENCH="32 64 128 256 512"
