# Super v3, wide EP: 16 nodes, TP4 x EP64 (16 DP groups, 8 experts per GPU).
# Wide-EP study (REPORT.md, 2026-10-17); concurrency 1-32 per GPU.
MODEL=superv3
NODES=16
TP=4
BUFFER_GB=50
MAMBA_RATIO=0.4
COMBINE_PRECISION=bf16
QOS=short
TIME=2:00:00

# Client sweep: total concurrency (64 GPUs), GSM8K prompts, 8192 output tokens (ignore_eos).
BENCH="64 128 256 512 1024 2048"
BENCH_OSL=8192
BENCH_ITERS=1
BENCH_WARMUP=1
