# Super v3, wide EP: 16 nodes, TP4 x EP64 (16 DP groups, 8 experts per GPU).
# Wide-EP study (REPORT.md, 2026-10-17); concurrency 1-32 per GPU.
MODEL=superv3
NODES=16
TP=4
BUFFER_GB=50
MAMBA_RATIO=0.4
COMBINE_PRECISION=bf16
QOS=short
TIME=2:00:00

# Steady-state client: total concurrency levels (64 GPUs) of closed-loop math-blend load, natural
# EOS with no output cap; 60 s warmup + 300 s window per level.
BENCH="64 128 256 512 1024 2048"
