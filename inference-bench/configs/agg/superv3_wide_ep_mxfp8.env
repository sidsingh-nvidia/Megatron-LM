# MXFP8 weights: superv3_wide_ep.env with the expert weights quantized to MXFP8 at load (MInf: TRT-LLM
# routed MXFP8 MoE kernel; FRAMEWORK=vllm: --quantization mxfp8). Everything else as in superv3_wide_ep.env.
# Super v3, wide EP on 64 GPUs: non-expert TP4 x DP16, experts EP64 (8 experts per GPU).
# Uses the full NVL72 domain for expert parallelism.
MODEL=superv3
NODES=16
TP=4
BUFFER_GB=50
MAMBA_RATIO=0.4
# CUDA-graphed prefill / mixed forwards pad their MoE work in proportion to the largest graph
# (rows bounded by graph tokens x EP, so 64x at wide EP); cap graphs at 512 tokens so larger
# prefill steps run eagerly with the exact token count.
CUDA_GRAPH_MAX_TOKENS=512
GEMM_BACKEND=trtllm_bf16_routed
COMBINE_PRECISION=bf16
# Math prompts are short and distinct, so prefix caching saves nothing; it is off for the math runs.
PREFIX_CACHING=0
QOS=short
TIME=2:00:00

# Steady-state client: total concurrency levels (64 GPUs) of closed-loop math-blend load, natural
# EOS with no output cap; 60 s warmup + 300 s window per level.
BENCH="64 128 256 512 1024 2048"

FP8_RECIPE=mxfp8
# With MXFP8, overlapping the shared experts on a side stream stalls the first CUDA graph warmup
# step (GPUs pinned at 100%, no progress); run them in order until that is understood.
SHARED_EXPERT_OVERLAP=0
