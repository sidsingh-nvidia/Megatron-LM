# Super v3, narrow EP on 64 GPUs: non-expert TP4 x DP16, experts EP4 x DP16 (a copy of the experts
# per TP4 replica, 128 experts per GPU). Simulates NVL8-style domains: EP stays within 4 GPUs.
MODEL=superv3
NODES=16
TP=4
EP=4
BUFFER_GB=50
MAMBA_RATIO=0.4
COMBINE_PRECISION=bf16
QOS=short
TIME=2:00:00

# Steady-state client: total concurrency levels (64 GPUs) of closed-loop math-blend load, natural
# EOS with no output cap; 60 s warmup + 300 s window per level.
BENCH="64 128 256 512 1024 2048"
