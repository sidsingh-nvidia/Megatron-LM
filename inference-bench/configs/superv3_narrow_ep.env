# Super v3, narrow EP: one node, TP4 x EP4 (one DP group, 128 experts per GPU).
# Wide-EP study baseline (REPORT.md, 2026-10-17); concurrency 1-32 per GPU.
MODEL=superv3
NODES=1
TP=4
BUFFER_GB=50
MAMBA_RATIO=0.4
COMBINE_PRECISION=bf16
TIME=2:00:00

# Steady-state client: total concurrency levels (4 GPUs) of closed-loop math-blend load, natural
# EOS capped at MAX_GEN_TOKENS; 60 s warmup + 300 s window per level.
BENCH="4 8 16 32 64 128"
