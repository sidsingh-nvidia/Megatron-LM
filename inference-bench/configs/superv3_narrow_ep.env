# Super v3, narrow EP: one node, TP4 x EP4 (one DP group, 128 experts per GPU).
# Wide-EP study baseline (REPORT.md, 2026-10-17); concurrency 1-32 per GPU.
MODEL=superv3
NODES=1
TP=4
BUFFER_GB=50
MAMBA_RATIO=0.4
DISPATCHER=nvls
COMBINE_PRECISION=bf16
GEMM_BACKEND=trtllm_bf16_routed
TIME=2:00:00

# Client sweep: total concurrency (4 GPUs), GSM8K prompts, 8192 output tokens (ignore_eos).
BENCH="4 8 16 32 64 128"
BENCH_OSL=8192
BENCH_ITERS=1
BENCH_WARMUP=1
