# Super v3, narrow EP: one TP4 x EP4 replica on 1 node (128 experts per GPU), simulating an NVL8
# domain. Narrow-EP replicas are independent, so one replica at 1/16 of the wide config's
# concurrency gives the same per-GPU throughput and per-user speed as 16 replicas on 64 GPUs.
MODEL=superv3
NODES=1
TP=4
EP=4
BUFFER_GB=50
MAMBA_RATIO=0.4
COMBINE_PRECISION=bf16
TIME=2:00:00

# Steady-state client: total concurrency levels (4 GPUs; x16 = the wide config's 64-GPU levels) of
# closed-loop math-blend load, natural EOS with no output cap; 60 s warmup + 300 s window per level.
BENCH="4 8 16 32 64 128"
